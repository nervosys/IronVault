        "args": [
          {"name": "--detailed", "short": "-d", "type": "bool", "required": false, "description": "Show detailed similarity scores"}
        ],
        "examples": ["iv deduplicate", "iv deduplicate --detailed"],
        "exitCodes": {"0": "Success"},
        "requiresPassphrase": true,
        "requiresUnlock": false,
        "output": "List of duplicate model groups"
      },
      {
        "name": "export",
        "description": "Export model with full metadata to a directory",
        "category": "utility",
        "args": [
          {"name": "name", "type": "string", "required": true, "positional": true, "description": "Model name"},
          {"name": "output", "type": "path", "required": true, "positional": true, "description": "Output directory"},
          {"name": "--version", "short": "-v", "type": "u32", "required": false, "description": "Version number (latest if not specified)"}
        ],
        "examples": ["iv export my-llm ./exported/"],
        "exitCodes": {"0": "Exported successfully", "3": "Not found"},
        "requiresPassphrase": true,
        "requiresUnlock": true
      },
      {
        "name": "cache",
        "description": "Show cache statistics (if caching is enabled)",
        "category": "utility",
        "args": [],
        "examples": ["iv cache"],
        "exitCodes": {"0": "Success"},
        "requiresPassphrase": false,
        "requiresUnlock": false,
        "output": "Cache hit/miss rates, size, entries"
      },
      {
        "name": "convert",
        "description": "Convert a model between formats with optional quantization",
        "category": "conversion",
        "args": [
          {"name": "name", "type": "string", "required": true, "positional": true, "description": "Model name in vault"},
          {"name": "--to-format", "short": "-t", "type": "string", "required": true, "enum": ["safetensors", "onnx", "gguf", "tflite", "coreml", "mlx", "torchscript", "tensorrt", "openvino"], "description": "Target format"},
          {"name": "--output", "short": "-o", "type": "path", "required": false, "description": "Output file path (defaults to model_name.{extension})"},
          {"name": "--version", "short": "-v", "type": "u32", "required": false, "description": "Source version to convert (latest if not specified)"},
          {"name": "--quantization", "short": "-q", "type": "string", "required": false, "enum": ["q4_0", "q4_k_m", "q5_k_m", "q8_0"], "description": "Quantization level for GGUF conversion"},
          {"name": "--opset", "type": "u32", "required": false, "default": 17, "description": "ONNX opset version"},
          {"name": "--validate", "type": "bool", "required": false, "description": "Validate conversion output"},
          {"name": "--plan-only", "type": "bool", "required": false, "description": "Show conversion plan without executing"},
          {"name": "--from-dir", "type": "path", "required": false, "description": "HuggingFace checkpoint directory; required for the native safetensors to GGUF path (llama, F16/BF16/F32). The vault is not opened in this mode, so no passphrase is needed"}
        ],
        "examples": [
          "iv convert my-llm --to-format gguf --quantization q4_k_m --validate",
          "iv convert my-llm -t onnx --opset 17",
          "iv convert my-llm -t safetensors --plan-only",
          "iv convert tinyllama --from-dir ./TinyLlama-1.1B -t gguf"
        ],
        "exitCodes": {"0": "Conversion successful", "4": "No conversion path or format error"},
        "requiresPassphrase": true,
        "requiresUnlock": true,
        "sideEffects": ["Creates new version in target format", "Emits ModelConverted event"],
        "longRunning": true
      },
      {
        "name": "list-conversions",
        "description": "List all supported format conversion paths",
        "category": "conversion",
        "args": [],
        "examples": ["iv list-conversions"],
        "exitCodes": {"0": "Success"},
        "requiresPassphrase": false,
        "requiresUnlock": false,
        "output": "Table of from→to conversion paths with quantization support"
      },
      {
        "name": "serve",
        "description": "Start the REST/GraphQL API server",
        "category": "api",
        "featureGate": "api",
        "args": [
          {"name": "--host", "type": "string", "required": false, "default": "127.0.0.1", "env": "IRONVAULT_HOST", "description": "Host address to bind to"},
          {"name": "--port", "short": "-p", "type": "u16", "required": false, "default": 8080, "env": "IRONVAULT_PORT", "description": "Port to listen on"},
          {"name": "--jwt-secret", "type": "string", "required": true, "env": "IRONVAULT_JWT_SECRET", "description": "JWT secret for token signing"},
          {"name": "--token-expiry", "type": "u64", "required": false, "default": 3600, "description": "Token expiry in seconds"},
          {"name": "--cors-permissive", "type": "bool", "required": false, "description": "Allow CORS from any origin"},
          {"name": "--no-dashboard", "type": "bool", "required": false, "description": "Disable the embedded web dashboard"},
          {"name": "--revocation-store", "type": "path", "required": false, "env": "IRONVAULT_REVOCATION_STORE", "description": "File to persist the JWT revocation list to. Without it, revoked tokens are re-admitted when the server restarts."}
        ],
        "examples": [
          "iv serve --jwt-secret mysecret",
          "iv serve --port 9090 --jwt-secret $IRONVAULT_JWT_SECRET --cors-permissive",
          "iv serve --jwt-secret $IRONVAULT_JWT_SECRET --revocation-store /var/lib/ironvault/revocations.json"
        ],
        "exitCodes": {"0": "Server stopped gracefully", "1": "Bind error"},
        "longRunning": true,
        "sideEffects": ["Starts HTTP server on specified port"]
      },
      {
        "name": "cloud",
        "description": "Cloud storage operations (push, pull, list, config)",
        "category": "cloud",
        "subcommands": [
          {
            "name": "push",
            "description": "Push encrypted model to cloud storage",
            "args": [
              {"name": "model", "type": "string", "required": true, "positional": true, "description": "Model name"},
              {"name": "--version", "short": "-v", "type": "u32", "required": false, "description": "Version number (latest if not specified)"},
              {"name": "--provider", "short": "-p", "type": "string", "required": true, "enum": ["s3", "azure", "gcs"], "description": "Cloud provider"},
              {"name": "--bucket", "short": "-b", "type": "string", "required": true, "description": "Bucket/container name"}
            ],
            "examples": ["iv cloud push my-llm --provider s3 --bucket my-models"],
            "exitCodes": {"0": "Pushed successfully", "1": "Cloud error or auth failure"},
            "requiresPassphrase": true,
            "requiresUnlock": true,
            "sideEffects": ["Uploads encrypted blob to cloud", "Emits CloudSynced event"]
          },
          {
            "name": "pull",
            "description": "Pull model from cloud storage into local vault",
            "args": [
              {"name": "model", "type": "string", "required": true, "positional": true, "description": "Local model name"},
              {"name": "--provider", "short": "-p", "type": "string", "required": true, "enum": ["s3", "azure", "gcs"], "description": "Cloud provider"},
              {"name": "--bucket", "short": "-b", "type": "string", "required": true, "description": "Bucket/container name"},
              {"name": "--remote-path", "short": "-k", "type": "string", "required": true, "description": "Remote path/key"}
            ],
            "examples": ["iv cloud pull my-llm --provider s3 --bucket my-models --remote-path models/my-llm.vault"],
            "exitCodes": {"0": "Pulled successfully", "1": "Cloud error"},
            "requiresPassphrase": true,
            "requiresUnlock": true,
            "sideEffects": ["Downloads and stores model locally", "Emits CloudSynced event"]
          },
          {
            "name": "list",
            "description": "List models in cloud storage bucket",
            "args": [
              {"name": "--provider", "short": "-p", "type": "string", "required": true, "enum": ["s3", "azure", "gcs"], "description": "Cloud provider"},
              {"name": "--bucket", "short": "-b", "type": "string", "required": true, "description": "Bucket/container name"},
              {"name": "--prefix", "short": "-x", "type": "string", "required": false, "description": "Path prefix filter"}
            ],
            "examples": ["iv cloud list --provider s3 --bucket my-models"],
            "exitCodes": {"0": "Success", "1": "Auth or network error"}
          },
          {
            "name": "config",
            "description": "Configure or show cloud provider credentials",
            "args": [
              {"name": "--provider", "short": "-p", "type": "string", "required": true, "enum": ["s3", "azure", "gcs"], "description": "Cloud provider"},
              {"name": "--show", "short": "-s", "type": "bool", "required": false, "description": "Show current configuration"}
            ],
            "examples": ["iv cloud config --provider s3 --show"]
          }
        ]
      },
      {
        "name": "card",
        "description": "Model card operations (create, show, validate, convert, template, attach, extract, generate)",
        "category": "documentation",
        "subcommands": [
          {
            "name": "create",
            "description": "Create a new model card",
            "args": [
              {"name": "name", "type": "string", "required": true, "positional": true, "description": "Model name"},
              {"name": "--version", "short": "-v", "type": "string", "required": true, "description": "Model version"},
              {"name": "--description", "short": "-d", "type": "string", "required": true, "description": "Model description"},
              {"name": "--model-type", "short": "-t", "type": "string", "required": true, "description": "Model type (e.g., 'Large Language Model')"},
              {"name": "--architecture", "short": "-a", "type": "string", "required": true, "description": "Architecture (e.g., 'Transformer')"},
              {"name": "--output", "short": "-o", "type": "path", "required": true, "description": "Output file (JSON, YAML, or Markdown by extension)"},
              {"name": "--interactive", "short": "-i", "type": "bool", "required": false, "description": "Open interactive wizard"}
            ],
            "examples": ["iv card create my-llm -v 1.0 -d 'Fine-tuned model' -t 'LLM' -a 'Transformer' -o card.json"]
          },
          {
            "name": "show",
            "description": "Display a model card",
            "args": [
              {"name": "path", "type": "path", "required": true, "positional": true, "description": "Path to model card file"},
              {"name": "--format", "short": "-f", "type": "string", "required": false, "default": "markdown", "enum": ["json", "yaml", "markdown"], "description": "Output format"}
            ],
            "examples": ["iv card show card.json", "iv card show card.yaml --format markdown"]
          },
          {
            "name": "validate",
            "description": "Validate a model card for completeness",
            "args": [
              {"name": "path", "type": "path", "required": true, "positional": true, "description": "Path to model card file"},
              {"name": "--strict", "short": "-s", "type": "bool", "required": false, "description": "Check for all required fields"}
            ],
            "examples": ["iv card validate card.json --strict"]
          },
          {
            "name": "convert",
            "description": "Convert model card between formats",
            "args": [
              {"name": "input", "type": "path", "required": true, "positional": true, "description": "Input model card file"},
              {"name": "output", "type": "path", "required": true, "positional": true, "description": "Output file (format by extension)"}
            ],
            "examples": ["iv card convert card.json card.md"]
          },
          {
            "name": "template",
            "description": "Generate a template model card",
            "args": [
              {"name": "--template-type", "short": "-t", "type": "string", "required": false, "default": "basic", "enum": ["basic", "llm", "classifier", "medical", "hiring"], "description": "Template type"},
              {"name": "--output", "short": "-o", "type": "path", "required": true, "description": "Output file"}
            ],
            "examples": ["iv card template -t llm -o llm-card.json"]
          },
          {
            "name": "attach",
            "description": "Attach a model card to a vault model",
            "args": [
              {"name": "model", "type": "string", "required": true, "positional": true, "description": "Model name in vault"},
              {"name": "--version", "short": "-v", "type": "u32", "required": false, "description": "Version number (latest if not specified)"},
              {"name": "card", "type": "path", "required": true, "positional": true, "description": "Path to model card file"}
            ],
            "examples": ["iv card attach my-llm card.json", "iv card attach my-llm -v 2 card.yaml"]
          },
          {
            "name": "extract",
            "description": "Extract model card from a vault model",
            "args": [
              {"name": "model", "type": "string", "required": true, "positional": true, "description": "Model name in vault"},
              {"name": "--version", "short": "-v", "type": "u32", "required": false, "description": "Version number (latest if not specified)"},
              {"name": "--output", "short": "-o", "type": "path", "required": true, "description": "Output file"}
            ],
            "examples": ["iv card extract my-llm -o card.json"]
          },
          {
            "name": "generate",
            "description": "Auto-generate model card from vault model metadata",
            "args": [
              {"name": "model", "type": "string", "required": true, "positional": true, "description": "Model name in vault"},
              {"name": "--version", "short": "-v", "type": "u32", "required": false, "description": "Version number (latest if not specified)"},
              {"name": "--output", "short": "-o", "type": "path", "required": true, "description": "Output file"},
              {"name": "--include-training", "type": "bool", "required": false, "description": "Include training data section"},
              {"name": "--include-evaluation", "type": "bool", "required": false, "description": "Include evaluation section"}
            ],
            "examples": ["iv card generate my-llm -o card.md --include-training --include-evaluation"]
          }
        ]
      },
      {
        "name": "database",
        "description": "RAG knowledge base operations (init, store, get, search, list, delete, export, import, stats, build-index, vector-search)",
        "category": "rag",
        "subcommands": [
          {
            "name": "init",
            "description": "Initialize a new RAG database",
            "args": [
              {"name": "--path", "short": "-p", "type": "path", "required": true, "description": "Database path"},
              {"name": "--db-type", "short": "-t", "type": "string", "required": false, "default": "sqlite", "enum": ["sqlite", "sled"], "description": "Database backend type"}
            ],
            "examples": ["iv database init --path ./kb --db-type sqlite"]
          },
          {
            "name": "store",
            "description": "Store a document in the database",
            "args": [
              {"name": "--path", "short": "-p", "type": "path", "required": true, "description": "Database path"},
              {"name": "--input", "short": "-i", "type": "path", "required": true, "description": "Document file to ingest"},
              {"name": "--id", "short": "-I", "type": "string", "required": false, "description": "Document ID (generated if not provided)"},
              {"name": "--metadata", "short": "-m", "type": "string[]", "required": false, "description": "Metadata key=value pairs"}
            ],
            "examples": ["iv database store --path ./kb --input paper.pdf", "iv database store --path ./kb --input notes.md --id my-notes --metadata source=manual"]
          },
          {
            "name": "get",
            "description": "Retrieve a document by ID",
            "args": [
              {"name": "--path", "short": "-p", "type": "path", "required": true, "description": "Database path"},
              {"name": "id", "type": "string", "required": true, "positional": true, "description": "Document ID"}
            ],
            "examples": ["iv database get --path ./kb my-doc-id"]
          },
          {
            "name": "search",
            "description": "Full-text and semantic search across documents",
            "args": [
              {"name": "--path", "short": "-p", "type": "path", "required": true, "description": "Database path"},
              {"name": "query", "type": "string", "required": true, "positional": true, "description": "Search query"},
              {"name": "--limit", "short": "-n", "type": "usize", "required": false, "default": 10, "description": "Maximum results"}
            ],
            "examples": ["iv database search --path ./kb 'transformer attention mechanism'"]
          },
          {
            "name": "list",
            "description": "List all documents in the database",
            "args": [
              {"name": "--path", "short": "-p", "type": "path", "required": true, "description": "Database path"}
            ],
            "examples": ["iv database list --path ./kb"]
          },
          {
            "name": "delete",
            "description": "Delete a document by ID",
            "args": [
              {"name": "--path", "short": "-p", "type": "path", "required": true, "description": "Database path"},
              {"name": "id", "type": "string", "required": true, "positional": true, "description": "Document ID"}
            ],
            "examples": ["iv database delete --path ./kb my-doc-id"],
            "destructive": true
          },
          {
            "name": "export",
            "description": "Export database contents to JSON",
            "args": [
              {"name": "--path", "short": "-p", "type": "path", "required": true, "description": "Database path"},
              {"name": "--output", "short": "-o", "type": "path", "required": true, "description": "Output JSON file"}
            ],
            "examples": ["iv database export --path ./kb -o backup.json"]
          },
          {
            "name": "import",
            "description": "Import documents from JSON",
            "args": [
              {"name": "--path", "short": "-p", "type": "path", "required": true, "description": "Database path"},
              {"name": "--input", "short": "-i", "type": "path", "required": true, "description": "Input JSON file"}
            ],
            "examples": ["iv database import --path ./kb -i backup.json"]
          },
          {
            "name": "stats",
            "description": "Show database statistics",
            "args": [
              {"name": "--path", "short": "-p", "type": "path", "required": true, "description": "Database path"}
            ],
            "examples": ["iv database stats --path ./kb"]
          },
          {
            "name": "build-index",
            "description": "Build vector index for similarity search",
            "args": [
              {"name": "--path", "short": "-p", "type": "path", "required": true, "description": "Database path"},
              {"name": "--output", "short": "-o", "type": "path", "required": true, "description": "Output index path"}
            ],
            "examples": ["iv database build-index --path ./kb -o ./kb-index"]
          },
          {
            "name": "vector-search",
            "description": "Search by vector similarity using prebuilt index",
            "args": [
              {"name": "--index", "short": "-i", "type": "path", "required": true, "description": "Index path"},
              {"name": "--query", "short": "-q", "type": "path", "required": true, "description": "Query text or embedding file"},
              {"name": "--limit", "short": "-n", "type": "usize", "required": false, "default": 5, "description": "Number of results"}
            ],
            "examples": ["iv database vector-search --index ./kb-index --query ./query.txt"]
          }
        ]
      },
