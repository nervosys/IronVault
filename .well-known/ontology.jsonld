            "args": [],
            "examples": ["iv telemetry reset"]
          }
        ]
      },
      {
        "name": "introspect",
        "description": "Output complete CLI schema as machine-readable JSON for agent discovery",
        "category": "system",
        "args": [
          {"name": "--format", "short": "-f", "type": "string", "required": false, "default": "json", "enum": ["json", "yaml", "jsonld"], "description": "Output format"},
          {"name": "--compact", "type": "bool", "required": false, "description": "Minimize output (no descriptions or examples)"}
        ],
        "examples": ["iv introspect", "iv introspect --format yaml", "iv introspect --compact"],
        "exitCodes": {"0": "Success"},
        "requiresPassphrase": false,
        "requiresUnlock": false,
        "output": "Complete CLI command schema with all arguments, types, defaults, constraints, and examples"
      }
    ],

    "compositionPatterns": {
      "@comment": "Common multi-command workflows that agents should know about",
      "patterns": [
        {
          "name": "store-and-convert",
          "description": "Store a model then convert it for edge deployment",
          "steps": [
            "iv init",
            "iv store my-llm ./model.safetensors -d 'Base model'",
            "iv convert my-llm --to-format gguf --quantization q4_k_m --validate"
          ]
        },
        {
          "name": "store-and-push",
          "description": "Store a model locally then push to cloud",
          "steps": [
            "iv store my-llm ./model.safetensors",
            "iv cloud push my-llm --provider s3 --bucket my-models"
          ]
        },
        {
          "name": "pull-and-convert",
          "description": "Pull a model from cloud and convert for local inference",
          "steps": [
            "iv cloud pull my-llm --provider s3 --bucket my-models --remote-path models/llm.vault",
            "iv convert my-llm --to-format gguf --quantization q4_k_m"
          ]
        },
        {
          "name": "full-audit",
          "description": "Run a complete vault audit",
          "steps": [
            "iv compliance",
            "iv stats",
            "iv deduplicate --detailed"
          ]
        },
        {
          "name": "rag-pipeline",
          "description": "Set up a RAG knowledge base and search it",
          "steps": [
            "iv database init --path ./kb --db-type sqlite",
            "iv database store --path ./kb --input paper.pdf",
            "iv database build-index --path ./kb -o ./kb-index",
            "iv database search --path ./kb 'attention mechanism'"
          ]
        },
        {
          "name": "model-documentation",
          "description": "Create and attach model documentation",
          "steps": [
            "iv card generate my-llm -o card.json --include-training --include-evaluation",
            "iv card validate card.json --strict",
            "iv card attach my-llm card.json"
          ]
        }
      ]
    },

    "outputParsing": {
      "@comment": "How agents should parse CLI output for programmatic use",
      "conventions": [
        "Exit code 0 always means success",
        "Non-zero exit codes map to error categories (see iv:errors)",
        "Structured output is available via --format json where supported",
        "iv introspect outputs machine-readable schema in JSON/YAML/JSON-LD",
        "Error messages are written to stderr, data to stdout",
        "Progress indicators are written to stderr"
      ],
      "jsonOutput": "Most commands support --format json for structured output parsing. Use iv introspect for the complete machine-readable CLI schema."
    }
  },

