      },
      {
        "name": "archive",
        "description": "Archive one or more models to TAR or ZIP",
        "category": "utility",
        "args": [
          {"name": "models", "type": "string[]", "required": true, "positional": true, "description": "Model names to archive"},
          {"name": "output", "type": "path", "required": true, "positional": true, "description": "Output archive path"},
          {"name": "--format", "short": "-f", "type": "string", "required": false, "default": "tar", "enum": ["tar", "zip"], "description": "Archive format"},
          {"name": "--versions", "short": "-v", "type": "u32[]", "required": false, "description": "Version numbers (latest for each if not specified)"}
        ],
        "examples": [
          "iv archive my-llm my-cnn ./models.tar",
          "iv archive my-llm ./backup.zip -f zip -v 1 -v 3"
        ],
        "exitCodes": {"0": "Archive created", "3": "Model not found"},
        "requiresPassphrase": true,
        "requiresUnlock": true
      },
      {
        "name": "extract",
        "description": "Extract models from a TAR or ZIP archive",
        "category": "utility",
        "args": [
          {"name": "archive", "type": "path", "required": true, "positional": true, "description": "Archive file path"},
          {"name": "--output", "short": "-o", "type": "path", "required": false, "default": ".", "description": "Output directory"}
        ],
        "examples": ["iv extract ./models.tar", "iv extract ./backup.zip -o ./restored"],
        "exitCodes": {"0": "Extracted successfully", "1": "Invalid archive"}
      },
      {
        "name": "analyze",
        "description": "Analyze model compression efficiency and metadata",
        "category": "utility",
        "args": [
          {"name": "name", "type": "string", "required": true, "positional": true, "description": "Model name"},
          {"name": "--version", "short": "-v", "type": "u32", "required": false, "description": "Version number (latest if not specified)"}
        ],
        "examples": ["iv analyze my-llm", "iv analyze my-llm -v 2"],
        "exitCodes": {"0": "Success", "3": "Not found"},
        "requiresPassphrase": true,
        "requiresUnlock": false,
        "output": "Size, compression ratio, format details, parameter estimates"
      },
      {
        "name": "deduplicate",
        "description": "Find duplicate models in vault using SHA-256 comparison",
