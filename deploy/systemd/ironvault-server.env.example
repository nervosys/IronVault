# Environment for the ironvault-server systemd unit.
#
# Copy to /etc/ironvault/server.env, then:
#   sudo chown root:root /etc/ironvault/server.env
#   sudo chmod 0600 /etc/ironvault/server.env
#
# This file contains credentials. It is deliberately NOT tracked in git --
# `.env` and `*.env` are gitignored. Do not commit a filled-in copy, and do not
# move these values into /etc/environment or a profile script: that would put
# the bearer token into the environment of every process on the machine,
# including any that log their own environment on crash.

# ── API ──────────────────────────────────────────────────────────────────────

# Required. Must be at least 32 bytes (RFC 7518 requires an HMAC key at least
# as large as the hash output for HS256). Generate with:
#   openssl rand -base64 48
IRONVAULT_JWT_SECRET=

# ── Telemetry ────────────────────────────────────────────────────────────────

# Telemetry is opt-in and off by default. Set this to true only if you intend
# this deployment to report usage. Setting the OTEL_* variables below does not
# by itself turn telemetry on.
IRONVAULT_TELEMETRY_ENABLED=false

# Standard OpenTelemetry exporter configuration. Leave the endpoint unset to
# disable OTLP export entirely; the binary then falls back to no export.
#OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com/otlp
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#OTEL_SERVICE_NAME=ironvault

# The Authorization header is a credential. Fill it in here, in this 0600
# root-owned file, and nowhere else.
#
# Rotate it if it has ever appeared in a shell history, a chat window, a CI
# log, or a commit -- a bearer token grants write access to your telemetry
# backend to anyone holding it.
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
