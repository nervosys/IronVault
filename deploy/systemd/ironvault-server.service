; systemd unit for the IronVault API server.
;
; Install:
;   sudo cp deploy/systemd/ironvault-server.service /etc/systemd/system/
;   sudo cp deploy/systemd/ironvault-server.env.example /etc/ironvault/server.env
;   sudo chmod 0600 /etc/ironvault/server.env && sudo chown root:root /etc/ironvault/server.env
;   sudo systemctl daemon-reload && sudo systemctl enable --now ironvault-server
;
; Configuration is service-scoped by design. Everything below applies to this
; unit only -- nothing is written to /etc/environment, /etc/profile.d, or any
; other machine-global location, so no other process on the host inherits the
; collector endpoint and, more importantly, none inherits the bearer token.

[Unit]
Description=IronVault API server
Documentation=https://github.com/nervosys/IronVault
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ironvault
Group=ironvault

; Secrets and configuration live here, readable only by root, loaded into this
; process and no other. Use EnvironmentFile rather than Environment= lines:
; Environment= values are visible in `systemctl show` and `systemd-analyze
; dump` to any local user, which for a bearer token means every account on the
; box can read it.
EnvironmentFile=/etc/ironvault/server.env

ExecStart=/usr/local/bin/iv serve \
    --host 127.0.0.1 \
    --port 8080 \
    --revocation-store /var/lib/ironvault/revocations.json

Restart=on-failure
RestartSec=5s

; Hardening. The vault holds model data and signing keys; a compromise of the
; API process should not reach the rest of the filesystem.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

; The only writable paths.
StateDirectory=ironvault
ReadWritePaths=/var/lib/ironvault

[Install]
WantedBy=multi-user.target
